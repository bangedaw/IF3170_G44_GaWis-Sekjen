{
  "name": "bonus_multi_truck",
  "problem": "src/data/multi_truck.json",
  "output_dir": "output/bonus_multi_truck",
  "seeds": [
    1,
    2,
    3
  ],
  "runs": [
    {
      "algorithm": "genetic_algorithm",
      "objective": "default",
      "label": "ga_multi_default_pop30_gen40",
      "params": {
        "population_size": 30,
        "generations": 40
      }
    },
    {
      "algorithm": "genetic_algorithm",
      "objective": "alt",
      "label": "ga_multi_alt_pop30_gen40",
      "params": {
        "population_size": 30,
        "generations": 40
      }
    },
    {
      "algorithm": "steepest_ascent_hc",
      "objective": "default",
      "label": "{algorithm}_multi_default",
      "params": {
        "neighbor_limit": null,
        "max_iterations": null
      }
    },
    {
      "algorithm": "stochastic_hc",
      "objective": "default",
      "label": "{algorithm}_multi_default",
      "params": {
        "mode": "uphill",
        "weighted": false,
        "neighbor_limit": null,
        "max_iterations": 1000
      }
    },
    {
      "algorithm": "sideways_move_hc",
      "objective": "default",
      "label": "{algorithm}_multi_default",
      "params": {
        "max_sideways": 100,
        "neighbor_limit": null,
        "max_iterations": null
      }
    },
    {
      "algorithm": "random_restart_hc",
      "objective": "default",
      "label": "{algorithm}_multi_default",
      "params": {
        "max_restart": 10,
        "base_algorithm": "steepest_ascent_hc",
        "base_params": {}
      }
    },
    {
      "algorithm": "simulated_annealing",
      "objective": "default",
      "label": "{algorithm}_multi_default",
      "params": {
        "t0": 50,
        "cooling": 0.9998,
        "t_min": 0.01,
        "max_iterations": 100000,
        "stuck_patience": 500,
        "return_best": false
      }
    }
  ]
}
