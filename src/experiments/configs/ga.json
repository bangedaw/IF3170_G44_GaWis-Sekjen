{
  "name": "genetic_algorithm",
  "problem": "src/data/medium.json",
  "objective": "default",
  "output_dir": "output/genetic_algorithm",
  "seeds": [1, 2, 3],
  "runs": [
    {
      "algorithm": "genetic_algorithm",
      "label": "ga_ctrl_pop30_gen{generations}",
      "params": {
        "population_size": 30
      },
      "grid": {
        "generations": [20, 40, 60]
      }
    },
    {
      "algorithm": "genetic_algorithm",
      "label": "ga_ctrl_gen40_pop{population_size}",
      "params": {
        "generations": 40
      },
      "grid": {
        "population_size": [15, 30, 60]
      }
    }
  ]
}
